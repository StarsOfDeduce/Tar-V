{
  "name": "tar-v",
  "version": "1.0.5",
  "description": "",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "audit:release": "node scripts/audit-release.js",
    "test": "node test/security.test.js && node test/launch.test.js",
    "test:renderer": "electron test/renderer-smoke.js --disable-gpu"
  },
  "build": {
    "appId": "com.starsofdeduce.tarv",
    "productName": "Tar V",
    "win": {
      "target": "nsis",
      "icon": "tray.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Tar V"
    },
    "files": [
      "main.js",
      "preload.js",
      "tray.png",
      "lib/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^42.11.15",
    "electron-builder": "^26.17.0"
  },
  "overrides": {
    "app-builder-lib": {
      "@electron/get": "5.1.0"
    }
  }
}
